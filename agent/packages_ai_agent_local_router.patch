diff --git a/Kconfig b/Kconfig
--- a/Kconfig
+++ b/Kconfig
@@ -49,6 +49,16 @@ config EXAMPLES_AI_AGENT_VELA_DATA_DIR
 		Base directory for config, memory and session files.
 		Must be on a writable filesystem (e.g. littlefs, romfs+ramdisk).
 
+config AI_AGENT_LOCAL_TOOL_ROUTER
+	bool "Enable offline MoonCat tool router"
+	default n
+	depends on TFLITEMICRO
+	---help---
+		Run the small int8 MoonCat intent model after the prompt-injection
+		guard and established keyword paths, but before the cloud LLM.
+		Accepted intents call the existing MoonCat and cron tools;
+		low-confidence and out-of-domain input continues to the LLM.
+
 config EXAMPLES_AI_AGENT_VELA_NODE_ID
 	string "Node client ID"
 	default "watch-01"
diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -85,6 +85,21 @@ endif
 CSRCS += src/tools/skill_loader.c
 CSRCS += src/tools/tool_guard.c
 
+ifeq ($(CONFIG_AI_AGENT_LOCAL_TOOL_ROUTER),y)
+CSRCS += src/tools/mooncat_local_router.c
+CXXEXT = .cc
+CXXSRCS += src/tools/mooncat_intent_model.cc
+CXXFLAGS += ${INCDIR_PREFIX}$(CURDIR)/include
+CXXFLAGS += ${INCDIR_PREFIX}$(CURDIR)/src
+CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/mlearning/tflite-micro/tflite-micro
+CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/math/gemmlowp/gemmlowp
+CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/math/kissfft/kissfft
+CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/math/ruy/ruy
+CXXFLAGS += -DTFLITE_EMULATE_FLOAT
+CXXFLAGS += -DTF_LITE_DISABLE_X86_NEON
+CXXFLAGS += -DTF_LITE_STRIP_ERROR_STRINGS
+endif
+
 ifeq ($(CONFIG_AI_AGENT_SKILL_SYNC),y)
 CSRCS += src/tools/skill_sync.c
 endif
