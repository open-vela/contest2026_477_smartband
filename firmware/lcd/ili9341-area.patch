 static int ili9341_sendcmd(struct ili9341_lcd_s *lcd, const uint8_t cmd)
 {
+#if CONFIG_LCD_ILI9341_HARDWARE_SPI
+    int result;
+    LCD_DC_CMD;
+    result = hal_spi_write(LCD_SPI_PORT, (void *)&cmd, 1);
+    LCD_DC_DATA;
+    return result == 0 ? OK : -EIO;
+#else
     ili9341_lcd_send_cmd(cmd);
     return OK;
+#endif
 }
 
