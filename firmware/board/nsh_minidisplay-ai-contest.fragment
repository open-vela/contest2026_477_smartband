# 2026 openVela AI contest delta on top of the locked 58 FPS Gemini S1 config.
# Keep this file small: the unchanged product configuration remains in
# nsh_minidisplay.defconfig and is hash-locked separately.
CONFIG_LV_USE_ANIMIMG=y
CONFIG_LVX_USE_DEMO_OPENVELA_UI=y
# The stock mini launcher is a second LVGL owner of /dev/lcd0.  Starting it
# beside openvela_ui corrupts SPI1 transfers and leaves the panel white.
# CONFIG_LUNCHER_MINI_APP is not set
CONFIG_OPENVELA_UI_DATA_ROOT="/data/openvela_ui"
CONFIG_OPENVELA_UI_HTTP_TIMESYNC=y
CONFIG_EXAMPLES_AI_AGENT_VELA=y
CONFIG_EXAMPLES_AI_AGENT_VELA_PROGNAME="ai_agent"
CONFIG_EXAMPLES_AI_AGENT_VELA_PRIORITY=100
CONFIG_EXAMPLES_AI_AGENT_VELA_STACKSIZE=32768
CONFIG_EXAMPLES_AI_AGENT_VELA_DATA_DIR="/data/agent"
CONFIG_EXAMPLES_AI_AGENT_VELA_NODE_ID="watch-01"
CONFIG_EXAMPLES_AI_AGENT_VELA_NODE_DISPLAY_NAME="Smart Watch"
CONFIG_EXAMPLES_AI_AGENT_VELA_SHELL_ALLOWLIST=y
# CONFIG_EXAMPLES_AI_AGENT_VELA_SHELL_FULL is not set
# CONFIG_EXAMPLES_AI_AGENT_VELA_SHELL_DENY is not set
# CONFIG_AI_AGENT_LVGL_UI is not set
# CONFIG_AI_AGENT_FEISHU is not set
# CONFIG_AI_AGENT_WEIXIN is not set
# CONFIG_AI_AGENT_MQTT is not set
# CONFIG_AI_AGENT_NODE is not set
# CONFIG_AI_AGENT_MCP is not set
# CONFIG_AI_AGENT_TEST is not set
# CONFIG_AI_AGENT_AUDIO_PREPROCESS is not set
# CONFIG_AI_AGENT_AUDIO_ALSA_DIRECT is not set
CONFIG_AI_AGENT_AUDIO_CAPTURE_GAIN=6
CONFIG_AI_AGENT_TLS_CONN_POOL_SIZE=2
CONFIG_MBEDTLS_NET_C=y
CONFIG_SYSTEM_POPEN=y
CONFIG_SYSTEM_POPEN_STACKSIZE=16384
CONFIG_SYSTEM_POPEN_PRIORITY=100
# CONFIG_AI_AGENT_CAMERA is not set
# CONFIG_AI_AGENT_SKILL_SYNC is not set
# CONFIG_AI_AGENT_BLE_GATT is not set
# CONFIG_AI_AGENT_BLE_NET is not set
# CONFIG_AI_AGENT_REST_API is not set
CONFIG_FEATURE_SYSTEM_VELACLAW=y
CONFIG_MQ_MAXMSGSIZE=4096
