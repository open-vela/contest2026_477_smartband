  margin-left: auto;
  color: #ffbd7a;
  font-size: 9px;
}

.metrics {
  width: 100%;
  height: 45px;
  margin-top: 4px;
  flex-direction: row;
  justify-content: space-between;
}

.metric {
  width: 23%;
  height: 45px;
  border-radius: 10px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #11243b;
}

