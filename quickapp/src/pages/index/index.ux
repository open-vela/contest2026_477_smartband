  color: #f7fbff;
  font-size: 15px;
  font-weight: bold;
}

.metric-label {
  margin-top: 2px;
  color: #9fb5cc;
  font-size: 9px;
}

.result-card {
  width: 100%;
  height: 66px;
  margin-top: 5px;
  padding: 6px 8px;
  border-radius: 10px;
  flex-direction: column;
  background-color: #0d1c30;
}

